/***********************
 * REUSABLE COMPONENTS *
 ***********************/

const GovernorateFilter = ({ selected, onSelect }) => {
  const [open, setOpen] = useState(false);
  const dropdownRef = useRef(null);

  useEffect(() => {
    const handleClickOutside = (e) => {
      if (dropdownRef.current && !dropdownRef.current.contains(e.target)) setOpen(false);
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  return (
    <div className="relative" ref={dropdownRef}>
      <button
        onClick={() => setOpen((v) => !v)}
        className="w-10 h-10 flex items-center justify-center rounded-full bg-black text-white shadow-lg hover:scale-105 transition-transform border-2 border-amber-400"
        title="تصفية حسب المحافظة"
      >
        <FaFilter />
      </button>
      <AnimatePresence>
        {open && (
          <motion.div
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -10 }}
            className="absolute z-50 left-0 mt-2 w-64 max-h-80 overflow-y-auto rounded-lg bg-white dark:bg-gray-800 shadow-xl p-2 space-y-1"
          >
            {PALESTINIAN_GOVERNORATES.map((gov) => (
              <button
                key={gov}
                className={`w-full text-right px-3 py-2 rounded-md text-sm hover:bg-amber-50 dark:hover:bg-gray-700 transition-colors ${
                  selected === gov && "bg-amber-100 dark:bg-amber-900/50 font-semibold"
                }`}
                onClick={() => {
                  onSelect(gov === selected ? "" : gov);
                  setOpen(false);
                }}
              >
                {gov}
              </button>
            ))}
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
};

const ServiceHeader = ({ icon: Icon, title, onAddClick, selectedGov, onSelectGov }) => (
  <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-1">
    <div className="flex items-center gap-3 flex-wrap">
      <div className="p-3 bg-white/90 rounded-xl shadow-lg transform transition-all duration-300 hover:scale-105">
        <Icon className="text-2xl text-gray-800" />
      </div>
      <div className="space-y-1">
        <h3 className="text-2xl font-bold text-gray-800 dark:text-white">{title}</h3>
        {selectedGov && (
          <span className="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-200">
            {selectedGov}
            <button 
              onClick={(e) => {
                e.stopPropagation();
                onSelectGov('');
              }}
              className="mr-1 ml-2 text-amber-600 hover:text-amber-800 dark:text-amber-400 dark:hover:text-amber-200"
            >
              ×
            </button>
          </span>
        )}
      </div>
    </div>
    <div className="flex items-center gap-3">
      <button
        onClick={onAddClick}
        className="flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 text-white px-5 py-2.5 rounded-xl shadow-lg hover:shadow-xl hover:from-amber-600 hover:to-amber-700 transition-all duration-300 transform hover:-translate-y-0.5"
      >
        <FaPlus className="text-lg" />
        <span className="font-medium">{(onAddClick && BUTTON_TEXTS[onAddClick]) ?? "إضافة"}</span>
      </button>
      <GovernorateFilter selected={selectedGov} onSelect={onSelectGov} />
    </div>
  </div>
);

