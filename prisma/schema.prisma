generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_id     BigInt          @unique @default(autoincrement())
  email         String          @unique
  password      String?
  name          String?
  role_id       Int             @default(2) @db.SmallInt
  city          String?
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  ads           ads[]
  chat_sessions chat_sessions[]
  comments      comments[]
  notifications notifications[]
  orders        orders[]
  reports       reports[]
  stores        stores[]
  user_events   user_events[]
  roles         roles           @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ad_tags {
  ad_id  String @db.Uuid
  tag_id String @db.Uuid
  ads    ads    @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags   tags   @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([ad_id, tag_id])
}

model ads {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_id   BigInt                   @unique @default(autoincrement())
  user_id     String?                  @db.Uuid
  category_id String?                  @db.Uuid
  title       String
  description String?
  price       Decimal?                 @db.Decimal
  location    Unsupported("geometry")?
  embedding   Unsupported("vector")?
  created_at  DateTime?                @default(now()) @db.Timestamptz(6)
  ad_tags     ad_tags[]
  categories  categories?              @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users?                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders      orders[]

  @@index([embedding], map: "ads_vec_idx")
  @@index([location], map: "idx_ads_geo", type: Gist)
}

model categories {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_id        BigInt       @unique @default(autoincrement())
  name             String
  parent_id        String?      @db.Uuid
  ads              ads[]
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")
}

model chat_messages {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String?        @db.Uuid
  sender        msg_sender?
  content       String?
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  chat_sessions chat_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chat_sessions {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?         @db.Uuid
  started_at    DateTime?       @default(now()) @db.Timestamptz(6)
  chat_messages chat_messages[]
  users         users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model comments {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  target_type String
  target_id   String    @db.Uuid
  comment     String?
  rating      Int?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model media {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_type String
  owner_id   String                 @db.Uuid
  file_path  String
  width      Int?
  height     Int?
  embedding  Unsupported("vector")?
  labels     String[]
  created_at DateTime?              @default(now()) @db.Timestamptz(6)

  @@index([embedding], map: "media_vec_idx")
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  content    String?
  read       Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model offer_tags {
  offer_id String @db.Uuid
  tag_id   String @db.Uuid
  offers   offers @relation(fields: [offer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags     tags   @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([offer_id, tag_id])
}

model offers {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_id   BigInt                 @unique @default(autoincrement())
  store_id    String?                @db.Uuid
  title       String
  description String?
  expires_at  DateTime?              @db.Timestamptz(6)
  embedding   Unsupported("vector")?
  created_at  DateTime?              @default(now()) @db.Timestamptz(6)
  offer_tags  offer_tags[]
  stores      stores?                @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([embedding], map: "offers_vec_idx")
}

model orders {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_id  BigInt        @unique @default(autoincrement())
  user_id    String?       @db.Uuid
  ad_id      String?       @db.Uuid
  status     order_status? @default(pending)
  created_at DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at DateTime?     @db.Timestamptz(6)
  ads        ads?          @relation(fields: [ad_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reports {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  subject    String?
  message    String?
  status     String?   @default("open")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model roles {
  id    Int     @id @default(autoincrement()) @db.SmallInt
  name  String  @unique
  users users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model store_tags {
  store_id String @db.Uuid
  tag_id   String @db.Uuid
  stores   stores @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags     tags   @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([store_id, tag_id])
}

model stores {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_id   BigInt                   @unique @default(autoincrement())
  owner_id    String?                  @db.Uuid
  name        String
  description String?
  location    Unsupported("geometry")?
  created_at  DateTime?                @default(now()) @db.Timestamptz(6)
  offers      offers[]
  store_tags  store_tags[]
  users       users?                   @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([location], map: "idx_stores_geo", type: Gist)
}

model tags {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @unique
  ad_tags    ad_tags[]
  offer_tags offer_tags[]
  store_tags store_tags[]
}

model user_events {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?    @db.Uuid
  target_type String
  target_id   String     @db.Uuid
  event       event_type
  metadata    Json?
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  users       users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_events_user")
}

enum event_type {
  view
  click
  like
  order
}

enum msg_sender {
  user
  assistant
}

enum order_status {
  pending
  accepted
  rejected
  done
}
