{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "buildCommand": "pnpm run vercel-build",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "env": {
    "PRISMA_GENERATE_DATAPROXY": "false",
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "nodeVersion": "20.x"
}
